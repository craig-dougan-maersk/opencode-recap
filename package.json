{
  "name": "opencode-recap",
  "version": "2.0.0",
  "description": "OpenCode TUI plugin - AI session recap in the sidebar",
  "repository": {
    "type": "git",
    "url": "https://github.com/craig-dougan-maersk/opencode-recap"
  },
  "homepage": "https://github.com/craig-dougan-maersk/opencode-recap",
  "bugs": {
    "url": "https://github.com/craig-dougan-maersk/opencode-recap/issues"
  },
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.tsx"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "recap.png"
  ],
  "scripts": {
    "compile": "rm -rf dist && mkdir -p dist && cp index.ts dist/tui.tsx",
    "prepublishOnly": "npm run compile",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sidebar",
    "recap"
  ],
  "license": "MIT",
  "engines": {
    "opencode": ">=2.0.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  }
}
